{
  "name": "@bridger-kr/tokens",
  "version": "2.0.1",
  "private": false,
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./css": "./css/index.css",
    "./css/contract": "./css/contract.css",
    "./css/colors": "./css/colors.css",
    "./css/typography": "./css/typography.css",
    "./css/spacing": "./css/spacing.css",
    "./css/base": "./css/base.css",
    "./css/fonts": "./css/fonts.css",
    "./css/reset": "./css/reset.css",
    "./css/legacy-classes": "./css/legacy-classes.css",
    "./assets/*": "./assets/*",
    "./styles.css": "./css/index.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "css",
    "assets"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/node": "^26.0.1"
  }
}
