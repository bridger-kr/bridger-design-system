{
  "name": "@bridger-kr/react",
  "version": "0.2.0",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./styles.css": "./dist/styles.css",
    "./components/*": {
      "import": {
        "types": "./dist/components/*/index.d.ts",
        "default": "./dist/components/*/index.mjs"
      },
      "require": {
        "types": "./dist/components/*/index.d.cts",
        "default": "./dist/components/*/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "build:css": "lightningcss --minify --bundle --targets '>= 0.5%, not dead' src/styles.css -o dist/styles.css",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "dev": "tsup --watch"
  },
  "peerDependencies": {
    "lucide-react": "^1.11.0",
    "react": "^19",
    "react-dom": "^19"
  },
  "dependencies": {
    "@base-ui-components/react": "1.0.0-rc.0",
    "@bridger-kr/tokens": "^0.2.0"
  },
  "devDependencies": {
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "axe-core": "4.13.0",
    "jsdom": "29.1.1",
    "lightningcss-cli": "^1.33.0",
    "lucide-react": "1.11.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "vitest-axe": "1.0.0-pre.5"
  },
  "publishConfig": {
    "access": "public"
  }
}
