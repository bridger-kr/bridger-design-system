// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`Field > matches the en snapshot 1`] = `
<div
  class="dt-field-group"
  data-invalid=""
>
  <label
    class="dt-field-label"
    for="spec"
  >
    Spec file
    <span
      aria-hidden="true"
      class="dt-field-required"
    >
      *
    </span>
  </label>
  <input
    aria-describedby="spec-hint spec-error"
    aria-invalid="true"
    aria-required="true"
    id="spec"
    required=""
  />
  <span
    class="dt-field-hint"
    id="spec-hint"
  >
    JSON or YAML
  </span>
  <span
    class="dt-field-error"
    id="spec-error"
  >
    Required field
  </span>
</div>
`;

