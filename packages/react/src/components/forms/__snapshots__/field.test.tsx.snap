// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`Field > matches the en snapshot 1`] = `
<div
  class="dt-field-group"
  data-invalid=""
  style="display: grid; gap: 7px;"
>
  <label
    for="spec"
    style="font-size: 13px; font-weight: 600; color: var(--dt-muted-strong);"
  >
    Spec file
    <span
      aria-hidden="true"
      style="margin-left: 4px; color: var(--dt-accent);"
    >
      *
    </span>
  </label>
  <input
    aria-describedby="spec-hint spec-error"
    aria-invalid="true"
    aria-required="true"
    id="spec"
    required=""
  />
  <span
    id="spec-hint"
    style="font-size: 12px; color: var(--dt-muted);"
  >
    JSON or YAML
  </span>
  <span
    id="spec-error"
    style="font-size: 12px; font-weight: 500; color: var(--dt-danger);"
  >
    Required field
  </span>
</div>
`;

